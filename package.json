{
  "name": "ps-randbats-ext",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-sets": "node scripts/build-randbats-items.cjs",
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
